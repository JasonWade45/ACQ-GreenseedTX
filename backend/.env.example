# Acquisitions Assistant AI — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# --- App --------------------------------------------------------------------
APP_HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./acquisitions.db
TIMEZONE=America/New_York
LOG_LEVEL=INFO

# --- REsimpli Open API v6 ----------------------------------------------------
# Find your key in REsimpli: Settings -> "Webhook - API Token" -> API Token tab
# -> "Generate Open API Token"  (not the Zapier token; the Webhook tab is unrelated)
# Auth header format used by the API:  Authorization: <API_KEY>   (raw key)
RESIMPLI_API_KEY=
RESIMPLI_BASE_URL=https://api.resimpli.com/api/v6/openapi
RESIMPLI_TIMEOUT_SECONDS=30
# Help centre documents 500 requests/minute (raised 1 Oct 2026); the older
# developer-portal figure of 100 is superseded. Keep a margin below 500.
RESIMPLI_RATE_LIMIT_PER_MINUTE=100
RESIMPLI_MAX_RETRIES=4
# Force the built-in mock client (no network) even if a key is present:
RESIMPLI_MOCK=false

# --- Synchronisation ---------------------------------------------------------
SYNC_ENABLED=false
SYNC_INTERVAL_MINUTES=30
SYNC_PAGE_LIMIT=100
SYNC_MAX_PAGES=500
SYNC_DETAIL_BUDGET=250

# --- Optional local AI (Ollama) ----------------------------------------------
AI_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=2048
OLLAMA_TIMEOUT_SECONDS=90

# --- Groq cloud AI (optional; primary when set) -------------------------------
# https://console.groq.com -> API Keys. OpenAI-compatible, fast and cheap.
# When set, Groq powers analysis + drafts and Ollama becomes the fallback.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TIMEOUT_SECONDS=30

# --- Misc --------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# Context window sent with each generation. Ollama's default (8192) can fail
# with HTTP 500 'failed to allocate buffer of size 8589934592' on CPU-only boxes.
OLLAMA_NUM_CTX=2048
# Ceiling for a single generation; a timeout puts the model in cooldown.
OLLAMA_TIMEOUT_SECONDS=90
# Seconds to skip the model after a generation failure (UI stays responsive).
OLLAMA_FAILURE_COOLDOWN_SECONDS=120
