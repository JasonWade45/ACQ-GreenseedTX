# Copy to .env. Keys stay on the backend. Local single-user defaults.
DATABASE_URL=sqlite:///./data/acquisitions.db
APP_TIMEZONE=America/New_York
APP_HOST=127.0.0.1
APP_PORT=8000
# Mandatory when binding beyond loopback. Choose a strong local password.
APP_ACCESS_PASSWORD=
SESSION_SECRET=
RESIMPLI_API_KEY=
RESIMPLI_MODE=disabled
# disabled | fixture | live. Fixture data is explicitly synthetic.
RESIMPLI_ADAPTER_PATH=
RESIMPLI_ADAPTER_VERIFIED=false
SYNC_ENABLED=false
SYNC_INTERVAL_MINUTES=30
SYNC_REQUESTS_PER_MINUTE=90
SYNC_MAX_PAGES=1000
SYNC_DEEP_REFRESH_HOURS=24
# No external lead creation or seller communication exists in this release.
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
MAX_UPLOAD_MB=25
MAX_IMPORT_ROWS=50000

# --- Hosted PostgreSQL (optional) -------------------------------------------------
# A plain postgres:// URL from Neon, Render or Supabase is accepted and normalised.
# A hosted host must carry sslmode=require (or verify-ca/verify-full); only a database
# on this machine may omit it. SQLite stays the default for the desktop app.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Exact browser origin of a separately hosted interface (Vercel). Comma-separated.
# Never "*": a wildcard would let any site drive an authenticated session.
CORS_ORIGINS=
# Shared secret for POST /api/cron/run. Empty hides the route entirely.
CRON_SECRET=
# Keep the in-process scheduler (sync, nightly backup, cadence). Turn it off on a host
# that suspends the process and call the cron route instead.
APP_SCHEDULER_ENABLED=true
# Where backups go when the database is not a file. Empty = the data folder.
BACKUP_DIR=
# Set to true on a host whose disk is wiped on redeploy: backups are still written, but
# the interface says to download them instead of trusting the folder.
EPHEMERAL_FILESYSTEM=false

# Optional Groq CLOUD AI. Disabled by default. No keys in frontend or source.
# Every cloud request requires a reviewed redacted preview and explicit approval.
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_DAILY_REQUEST_LIMIT=30
GROQ_MAX_OUTPUT_TOKENS=3000
# The Settings screen can save replacement keys to ignored .env.secrets.
