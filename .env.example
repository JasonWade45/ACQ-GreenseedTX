# Copy to .env. Keys stay on the backend. Local single-user defaults.
DATABASE_URL=sqlite:///./data/acquisitions.db
APP_TIMEZONE=America/New_York
APP_HOST=127.0.0.1
APP_PORT=8000
# Mandatory when binding beyond loopback. Choose a strong local password.
APP_ACCESS_PASSWORD=
SESSION_SECRET=
RESIMPLI_API_KEY=
RESIMPLI_MODE=disabled
# disabled | fixture | live. Fixture data is explicitly synthetic.
RESIMPLI_ADAPTER_PATH=
RESIMPLI_ADAPTER_VERIFIED=false
SYNC_ENABLED=false
SYNC_INTERVAL_MINUTES=30
SYNC_REQUESTS_PER_MINUTE=90
SYNC_MAX_PAGES=1000
SYNC_DEEP_REFRESH_HOURS=24
# No external lead creation or seller communication exists in this release.
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
MAX_UPLOAD_MB=25
MAX_IMPORT_ROWS=50000

# Optional Groq CLOUD AI. Disabled by default. No keys in frontend or source.
# Every cloud request requires a reviewed redacted preview and explicit approval.
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_DAILY_REQUEST_LIMIT=30
GROQ_MAX_OUTPUT_TOKENS=3000
# The Settings screen can save replacement keys to ignored .env.secrets.
