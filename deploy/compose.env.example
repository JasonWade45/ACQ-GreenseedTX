# Copy this file to deploy/.env (same folder), fill in the values, then run:
#   cd deploy && docker compose up -d --build
#
# NEVER commit deploy/.env and never upload it to Drive or a chat.

# Public domain that points at this server (DNS A/AAAA record must exist first).
SITE_ADDRESS=acq.example.com

# Required by the app for any non-loopback bind: at least 12 characters.
APP_ACCESS_PASSWORD=replace-with-a-long-random-password

# Random signing key for sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-a-64-character-random-hex-string

# Business timezone used by queues, reports and reminders.
APP_TIMEZONE=America/New_York
