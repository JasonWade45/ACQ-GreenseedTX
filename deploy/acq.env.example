# Environment for the bare-metal systemd install (deploy/acq.service).
# Copy to /etc/acq/acq.env, set a strong password, then:
#   sudo chown root:acq /etc/acq/acq.env && sudo chmod 640 /etc/acq/acq.env
#
# NEVER commit this file to Git or upload it to Drive.

APP_ACCESS_PASSWORD=replace-with-a-long-random-password
# python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-a-64-character-random-hex-string
APP_TIMEZONE=Africa/Cairo

# The service binds 0.0.0.0:8000; put a TLS proxy in front.
APP_HOST=0.0.0.0
APP_PORT=8000

# Data lives outside the checkout so `git pull` can never touch it.
DATABASE_URL=sqlite:////var/lib/acq/acquisitions.db

# Guarded features stay off until configured deliberately.
RESIMPLI_MODE=disabled
SYNC_ENABLED=false
GROQ_ENABLED=false
OLLAMA_ENABLED=false
